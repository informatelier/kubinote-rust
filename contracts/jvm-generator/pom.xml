<?xml version="1.0" encoding="UTF-8"?>
<!--
  Generatore dei golden file di KubiRAG. Gira contro il fat JAR di kubirag (implementazione
  Kotlin di riferimento): i file prodotti sono la suite di accettazione del porting Rust.

  mvn -q package -Dkubirag.jar=/percorso/kubirag-1.0.0-SNAPSHOT-jar-with-dependencies.jar
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>it.informatelier.kubirag</groupId>
  <artifactId>kubirag-contracts</artifactId>
  <version>1.0.0-SNAPSHOT</version>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>21</maven.compiler.release>
    <kotlin.version>2.3.0</kotlin.version>
    <kotlin.compiler.jvmTarget>21</kotlin.compiler.jvmTarget>
    <kubirag.jar>${project.basedir}/../../../kubirag/target/kubirag-1.0.0-SNAPSHOT-jar-with-dependencies.jar</kubirag.jar>
  </properties>

  <dependencies>
    <dependency>
      <groupId>it.informatelier.kubilang</groupId>
      <artifactId>kubirag-fat</artifactId>
      <version>1.0.0-SNAPSHOT</version>
      <scope>system</scope>
      <systemPath>${kubirag.jar}</systemPath>
    </dependency>
  </dependencies>

  <build>
    <sourceDirectory>${project.basedir}/src/main/kotlin</sourceDirectory>
    <finalName>kubirag-contracts</finalName>
    <plugins>
      <plugin>
        <groupId>org.jetbrains.kotlin</groupId>
        <artifactId>kotlin-maven-plugin</artifactId>
        <version>${kotlin.version}</version>
        <executions>
          <execution>
            <id>compile</id>
            <goals><goal>compile</goal></goals>
          </execution>
        </executions>
        <configuration>
          <compilerPlugins><plugin>kotlinx-serialization</plugin></compilerPlugins>
        </configuration>
        <dependencies>
          <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-maven-serialization</artifactId>
            <version>${kotlin.version}</version>
          </dependency>
        </dependencies>
      </plugin>
    </plugins>
  </build>
</project>
